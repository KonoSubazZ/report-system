<configuration>
    <property name="LOG_DIR" value="/data/soft/apache-tomcat-8.5.43/logs" />

    <!-- report_error 日志 -->
    <appender name="REPORT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/report_error.log</file>
        <append>true</append>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] [%level] [report] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- qrcode 日志 -->
    <appender name="QRCODE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/report_qrcode.log</file>
        <append>true</append>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] [%level] [qrcode] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- upload 日志 -->
    <appender name="UPLOAD_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/report_upload.log</file>
        <append>true</append>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] [%level] [upload] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 为每类日志绑定 logger 名称 -->
    <logger name="report" level="INFO" additivity="false">
        <appender-ref ref="REPORT_FILE"/>
    </logger>

    <logger name="qrcode" level="INFO" additivity="false">
        <appender-ref ref="QRCODE_FILE"/>
    </logger>

    <logger name="upload" level="INFO" additivity="false">
        <appender-ref ref="UPLOAD_FILE"/>
    </logger>

    <!-- root 默认输出，可省略 -->
    <root level="ERROR">
        <appender-ref ref="REPORT_FILE"/>
    </root>
</configuration>
