<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.ModuleDao">

    <select id="getProductDesc" resultType="com.novo.report.mod.ModProductDesc">
        select
            product_desc
        from mod_product_desc
        where template_name = #{templateName}
          and deleted = 1
    </select>
</mapper>