<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.TemplateConfDao">

    <select id="get" resultType="com.novo.report.beans.TemplateConf">
        select *
        from template_conf
        where template_name = #{templateName}
          and deleted = 0
    </select>

    <select id="list" resultType="com.novo.report.beans.TemplateConf">
        select *
        from template_conf
        where deleted = 0
    </select>

</mapper>