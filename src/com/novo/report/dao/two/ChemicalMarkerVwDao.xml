<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.ChemicalMarkerVwDao">
	<select id="getGeneFromChemicalMarkerVw" resultType="ChemicalMarkerVw">
		select distinct gene from this_chemical_marker_vw
		<where>
			<if test="platform!=null and platform!=''">
				platform = #{platform} 
			</if>
			<if test="product_name!=null and product_name!=''">
				and product_name =#{product_name}	
			</if>
			<if test="subbarcode!=null and subbarcode!=''">
				and subbarcode=#{subbarcode}
			</if>
			<if test="analysis_date!=null and analysis_date!=''">
			  and analysis_date = #{analysis_date}
			</if>
		</where>
	</select>

</mapper>