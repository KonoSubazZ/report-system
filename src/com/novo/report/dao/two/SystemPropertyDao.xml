<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.SystemPropertyDao">
	
	<select id="getTotal" resultType="Long">
		select count(id) from system_property
	</select>
	<select id="getSystemPropertyByPage" resultType="SystemProperty">
		select id,property_name,property_value
		from system_property
		limit #{pageNo},#{pageSize}
	</select>
	
	<insert id="save">
		insert into system_property (property_name,property_value)
			values(#{property_name},#{property_value})
	</insert>
	
	<select id="editSystemProperty" resultType="SystemProperty">
		select id,property_name,property_value from system_property where id=#{id}
	</select>
	
	<update id="updateSystemProperty">
		update system_property set 
			property_name=#{property_name},property_value=#{property_value}
			where id=#{id}
	</update>
	
	<select id="getPropertyValueByPropertyName" resultType="String">
		select property_value from system_property where property_name = #{property_name}
	</select>
</mapper>