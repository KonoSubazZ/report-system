<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.RpCrGeneRiskDao">
	
	 <insert id="insertRpCrGeneRisk" keyProperty="record_id" useGeneratedKeys="true">
		INSERT into rp_cr_gene_risk (gene,lang,hom_flag,cancer,age,risk_of_developing_cancer,risk_of_general_population,update_by,update_time) 
		values(#{gene},#{lang},#{hom_flag},#{cancer},#{age},#{risk_of_developing_cancer},#{risk_of_general_population},#{update_by},sysdate())
	</insert>
	
	<update id="updateRpCrGeneRisk">
		update rp_cr_gene_risk 
		<set>
			<if test="hom_flag !=null and hom_flag !=''">
				hom_flag=#{hom_flag},
			</if>
			<if test="cancer !=null and cancer !=''">
				cancer=#{cancer},
			</if>
			<if test="age !=null and age !=''">
				age=#{age},
			</if>
			<if test="risk_of_developing_cancer !=null and risk_of_developing_cancer !=''">
				risk_of_developing_cancer=#{risk_of_developing_cancer},
			</if>
			<if test="risk_of_general_population !=null and risk_of_general_population !=''">
				risk_of_general_population=#{risk_of_general_population},
			</if>
			<if test="update_by !=null and update_by !=''">
				update_by=#{update_by},
			</if>
			update_time = sysdate()
		</set>
		where record_id=#{record_id}
	</update>
	
	<select id="getRpCrGeneRiskList" resultType="java.util.Map">
		select record_id,gene,lang,hom_flag,cancer,age,risk_of_developing_cancer,risk_of_general_population,check_date from rp_cr_gene_risk WHERE gene = #{gene} and lang = #{lang}
	</select>
	
	<select id="getRpCrGeneRiskByRecordId" resultType="java.util.Map">
		select record_id,gene,lang,hom_flag,cancer,age,risk_of_developing_cancer,risk_of_general_population,check_date from rp_cr_gene_risk WHERE record_id=#{record_id}
	</select>
	
	<delete id="deleteDiseaseRiskByRecordId">
		DELETE FROM rp_cr_gene_risk WHERE record_id = #{record_id}
	</delete>
	
</mapper>