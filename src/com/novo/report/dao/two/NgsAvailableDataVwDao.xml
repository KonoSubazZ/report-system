<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novo.report.dao.two.NgsAvailableDataVwDao">
	<!--分页查询 -->
	<select id="getTotal" resultType="Long">
		select count(platform) from ngs_available_data_vw
		<where>
			
			<if test="platform!=null and platform!=''">
				and platform=#{platform}
			</if>
			<if test="analysis_date!=null and analysis_date!=''">
				and analysis_date like '%' #{analysis_date} '%'
			</if>
			<if test="subbarcode!=null and subbarcode!=''">
				and subbarcode =#{subbarcode}
			</if>
			<if test="status!=null and status!=''">
				and status like '%' #{status} '%'
			</if>
			<if test="product_name!=null and product_name!=''">
				and product_name =#{product_name}
			</if>
			<if test=" subbarcodes!=null and subbarcodes.length>0">
				and subbarcode in
				<foreach collection="subbarcodes" open="(" close=")" separator="," item="item">
					#{item}
				</foreach>
				
			</if>
		</where>
	</select>
	<select id="getNgsAvailableDataVwByPage" resultType="NgsAvailableDataVw">
		select report_id,platform, analysis_date,barcode,subbarcode,product_name, platform,primary_cancer,
		analyzer,checked_date,checked_by,report_time as report_date,report_filename,report_file_path,status
		from ngs_available_data_vw
		<where>
			<if test="platform!=null and platform!=''">
				and platform=#{platform}
			</if>
			<if test="analysis_date!=null and analysis_date!=''">
				and analysis_date like '%' #{analysis_date} '%'
			</if>
			<if test="subbarcode!=null and subbarcode!=''">
				and subbarcode =#{subbarcode}
			</if>
			<if test="status!=null and status!=''">
				and status like '%' #{status} '%'
			</if>
			<if test="product_name!=null and product_name!=''">
				and product_name =#{product_name}
			</if>
			<if test=" subbarcodes!=null and subbarcodes.length>0">
				and subbarcode in
				<foreach collection="subbarcodes" open="(" close=")" separator="," item="item">
					#{item}
				</foreach>
			</if>
		</where>
		order by report_id
		limit #{pageNo},#{pageSize} 
	</select>
	
	<select id="getSubbarcodeListByPlatform" resultType="String">
		select distinct subbarcode from ngs_available_data_vw
			<if test="platform!=null and platform!=''">
				where platform=#{platform}
			</if>
	</select>
	
	<select id="getProductNameListByPlatform" resultType="String">
		select distinct product_name from ngs_available_data_vw
			<if test="platform!=null and platform!=''">
				where platform=#{platform}
			</if>
	</select>
	
