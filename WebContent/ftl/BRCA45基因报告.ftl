												<w:sz w:val="18" />
												<w:szCs w:val="18" />
												<w:lang w:eastAsia="zh-CN" /></w:rPr>
											<w:t>。BRCA1相关的疾病还包括子宫内膜癌、肠癌、胃癌等</w:t>
										</w:r>
										<w:r>
											<w:rPr>
												<w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:eastAsia="微软雅黑" w:cs="Times New Roman" />
